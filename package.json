{
  "name": "@gaddario98/react-pages",
  "version": "3.0.3",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "scripts": {
    "build": "rollup -c rollup.config.js && rollup -c rollup.dts.config.js",
    "prepublishOnly": "yarn build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:native": "vitest -c vitest.config.native.ts",
    "test:perf": "vitest run --testNamePattern='performance'",
    "lint": "eslint .",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^26.5.0",
    "@types/rollup-plugin-peer-deps-external": "^2.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "babel-plugin-react-compiler": "1.0.0",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "rollup": "^4.63.1",
    "rollup-plugin-filesize": "^10.0.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@gaddario98/react-form": "^2.0.4",
    "@gaddario98/react-queries": "^2.0.3",
    "@gaddario98/react-state": "^2.0.3",
    "@tanstack/react-query": "^5.102.8",
    "fast-deep-equal": "^3.1.3",
    "jotai": "^2.20.3",
    "jotai-family": "^1.1.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0 <20.0.0"
  },
  "files": [
    "dist",
    "components",
    "config",
    "hooks",
    "utils",
    "index.ts",
    "types.ts"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gaddario98/react-pages"
  },
  "keywords": [
    "react",
    "generate-pages",
    "settings-generation",
    "pages",
    "component-library"
  ],
  "author": "Giosuè Addario",
  "bugs": {
    "url": "https://github.com/gaddario98/react-pages/issues"
  },
  "homepage": "https://github.com/gaddario98/react-pages#readme",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.mjs",
      "require": "./dist/components/index.js",
      "default": "./dist/components/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.mjs",
      "require": "./dist/config/index.js",
      "default": "./dist/config/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.mjs",
      "require": "./dist/hooks/index.js",
      "default": "./dist/hooks/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.mjs",
      "require": "./dist/utils/index.js",
      "default": "./dist/utils/index.js"
    }
  }
}
